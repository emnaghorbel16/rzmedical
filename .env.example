# ═══════════════════════════════════════════════════════════════════════════════
# RZMedical — .env.example (racine — Docker Compose)
# ═══════════════════════════════════════════════════════════════════════════════
# Ce fichier est lu par docker-compose.yml et docker-compose.prod.yml
# Copiez vers .env et remplissez TOUTES les valeurs marquées CHANGE_ME
# NE PAS committer le fichier .env — il est dans .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données ──────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rzmedical_db
DB_PORT=5432

# URL complète Prisma (remplacer si DB externe / cloud)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/rzmedical_db?schema=public

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# Générer : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h

# ── Email SMTP ───────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=CHANGE_ME_APP_PASSWORD
EMAIL_FROM_NAME=RZMedical

# ── URLs ─────────────────────────────────────────────────────────────────────
# URL du frontend boutique (dans les emails de validation)
# En production : https://randzmedical.com
FRONTEND_URL=http://localhost:3000

# URL publique du site (SEO, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL de l'API backend accessible depuis le navigateur
# En production : https://api.randzmedical.com/api  ou  https://randzmedical.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── CORS ──────────────────────────────────────────────────────────────────────
# CORS_ORIGIN : domaines autorisés séparés par virgule
# En dev : laisser vide ou mettre http://localhost:3000,http://localhost:3001
# En production : UNIQUEMENT les domaines officiels (jamais *)
CORS_ORIGIN=https://www.randzmedical.com,https://randzmedical.com

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=200

# ── Ports exposés (Docker) ────────────────────────────────────────────────────
# ⛔ IMPORTANT PRODUCTION : BACKEND_PORT doit être lié à 127.0.0.1 uniquement
# dans docker-compose.prod.yml : "127.0.0.1:${BACKEND_PORT:-4000}:4000"
# Cela empêche l'accès direct depuis Internet (seul Nginx peut joindre le backend)
BACKEND_PORT=4000
ADMIN_PORT=3001
WEB_PORT=3000
