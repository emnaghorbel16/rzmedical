# ═══════════════════════════════════════════════════════════════════════════════
# RZMedical — BACKEND .env.example
# ═══════════════════════════════════════════════════════════════════════════════
# Copiez ce fichier vers .env et remplissez les valeurs avant de démarrer.
# NE PAS committer le fichier .env avec de vraies valeurs.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ───────────────────────────────────────────────
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/rzmedical_db?schema=public

# ── Serveur ──────────────────────────────────────────────────────────────────
PORT=4000

# ── Sécurité JWT ─────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=8h

# ── Email SMTP ───────────────────────────────────────────────────────────────
# Gmail : activez "Mots de passe d'application" dans votre compte Google
# Autres fournisseurs : Mailgun, SendGrid, Brevo, etc.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=votre.email@gmail.com
EMAIL_PASS=votre_mot_de_passe_app_gmail
EMAIL_FROM_NAME=RZMedical

# ── URLs Frontend ─────────────────────────────────────────────────────────────
# URL publique du site boutique (utilisée dans les liens des emails)
# En production : https://randzmedical.com
FRONTEND_URL=http://localhost:3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# * = autoriser toutes les origines (développement uniquement)
# En production : https://randzmedical.com,https://admin.randzmedical.com
CORS_ORIGIN=*

# ── Uploads ───────────────────────────────────────────────────────────────────
# Chemin relatif ou absolu du dossier d'uploads
UPLOAD_DIR=uploads
# Taille maximale des fichiers en Mo (vidéos incluses)
MAX_FILE_SIZE_MB=200
