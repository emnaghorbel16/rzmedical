# ═══════════════════════════════════════════════════════════════════════════════
# RZMedical — WEB (Next.js boutique) .env.example
# ═══════════════════════════════════════════════════════════════════════════════
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# NE PAS committer .env.local — il est dans .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Backend ───────────────────────────────────────────────────────────────
# URL du backend sans /api à la fin (accessible depuis le navigateur ET le serveur)
# En production : https://api.randzmedical.com ou https://randzmedical.com (si même serveur)
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── URL publique du site ──────────────────────────────────────────────────────
# Utilisée pour les métadonnées SEO (og:url, canonical, etc.)
# En production : https://randzmedical.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Dev réseau local ──────────────────────────────────────────────────────────
# Origines autorisées pour tester depuis téléphone/tablette en réseau local
# Séparées par virgule. Laisser vide en production.
ALLOWED_DEV_ORIGINS=localhost,127.0.0.1

# ── IA — Chat produit (optionnel) ─────────────────────────────────────────────
# Ces clés ne sont JAMAIS exposées au navigateur (pas de préfixe NEXT_PUBLIC_)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
